				{
					"name": "AUTH",
					"item": [
						{
							"name": "auth/login",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 200\", function () {\r",
											"    pm.response.to.have.status(200);\r",
											"});\r",
											"\r",
											"// ดึงข้อมูลจาก response\r",
											"var jsonData = pm.response.json();\r",
											"\r",
											"// ตรวจสอบว่า login สำเร็จและมี token\r",
											"if (jsonData.res_code === \"0000\" && jsonData.res_data.access_token) {\r",
											"    // บันทึก access_token ลงใน Collection Variables\r",
											"    pm.collectionVariables.set(\"access_token\", jsonData.res_data.access_token);\r",
											"    \r",
											"    // บันทึก refresh_token เผื่อต้องใช้ในอนาคต\r",
											"    pm.collectionVariables.set(\"refresh_token\", jsonData.res_data.refresh_token);\r",
											"    \r",
											"    console.log(\"Token saved to collection variables!\");\r",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
