# ENV ทั่วไป
NEXT_PUBLIC_ENV=default
NEXT_PUBLIC_COMMON_VAR=some-value

# (localhost หรือ production)
NEXT_APP_USE_LOCATION=localhost

# DEBUG
NEXT_PUBLIC_DEBUG_MODE=true

# API base url แยกตาม location
NEXT_PUBLIC_API_BASE_URL_LOCALHOST=http://localhost:5876/api/v1
NEXT_PUBLIC_API_BASE_URL_PRODUCTION=http://10.40.30.25:5876/api/v1